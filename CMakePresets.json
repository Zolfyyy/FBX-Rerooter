{
    "version": 7,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 27,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "win-x64",
            "displayName": "Windows x64 (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "host=x64",
            "binaryDir": "${sourceDir}/build/win-x64",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x64 (Clang)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-x64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "-m64",
                "CMAKE_CXX_FLAGS": "-m64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-x64",
            "configurePreset": "win-x64"
        },
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        }
    ]
}