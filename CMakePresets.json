{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "win-x86",
            "displayName": "Windows x86 (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x86",
            "binaryDir": "${sourceDir}/build/win-x86",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "default",
            "displayName": "Windows x64 (MSVC) [default]",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/win-x64",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "win-x64",
            "displayName": "Windows x64 (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/win-x64",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x64 (GCC)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-x64",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "win-x86",
            "configurePreset": "win-x86"
        },
        {
            "name": "win-x64",
            "configurePreset": "win-x64"
        },
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        }
    ]
}